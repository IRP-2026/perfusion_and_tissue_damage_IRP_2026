<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Tetrahedron" NumberOfElements="3072" NodesPerElement="4">
        <DataItem Dimensions="3072 4" NumberType="Int" Format="HDF">press.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XYZ">
        <DataItem Dimensions="729 3" Format="HDF">press.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="Pressure_Compartment_1" GridType="Collection" CollectionType="Temporal">
      <Grid Name="Pressure_Compartment_1" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="Pressure_Compartment_1" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="729 1" Format="HDF">press.h5:/Function/Pressure_Compartment_1/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
